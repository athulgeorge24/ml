{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "29059767-dc80-4145-af0c-92f9eea32e44",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "b75ea81c-65dc-4057-add0-4426bafd154d",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.datasets import load_breast_cancer\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.linear_model import LogisticRegression"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "c4d2134c-b3f9-411e-b943-56458eb9ea83",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset Shape: (569, 30)\n",
      "Classes: [0 1]\n"
     ]
    }
   ],
   "source": [
    "from sklearn.metrics import(\n",
    "accuracy_score,\n",
    "precision_score,\n",
    "recall_score,\n",
    "f1_score,\n",
    "confusion_matrix,\n",
    "roc_curve,\n",
    "auc\n",
    ")\n",
    "\n",
    "data=load_breast_cancer()\n",
    "\n",
    "X=data.data\n",
    "Y=data.target\n",
    "\n",
    "print(\"Dataset Shape:\",X.shape)\n",
    "print(\"Classes:\",np.unique(Y))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "7bbfe7ce-27fe-405b-b54d-ef7253fb49a4",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train,X_test,Y_train,Y_test=train_test_split(\n",
    "    X,\n",
    "    Y,\n",
    "    test_size=0.2,\n",
    "    random_state=42,\n",
    "    stratify=Y\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "16ed6aa0-f0ac-4499-86fd-e83c5f19a9cc",
   "metadata": {},
   "outputs": [],
   "source": [
    "scaler=StandardScaler()\n",
    "\n",
    "X_train=scaler.fit_transform(X_train)\n",
    "X_test=scaler.transform(X_test)\n",
    "mle_model=LogisticRegression(\n",
    "    penalty=None,\n",
    "    max_iter=5000,\n",
    "    random_state=42,\n",
    ")\n",
    "\n",
    "mle_model.fit(X_train,Y_train)\n",
    "Y_pred_mle=mle_model.predict(X_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "7e48a1a9-d3dd-4d2d-939d-9b35c0a569f5",
   "metadata": {},
   "outputs": [],
   "source": [
    "map_l2=LogisticRegression(\n",
    "    penalty='l2',\n",
    "    C=1.0,\n",
    "    solver='lbfgs',\n",
    "    max_iter=5000,\n",
    "    random_state=42,\n",
    ")\n",
    "map_l2.fit(X_train,Y_train)\n",
    "Y_pred_l2=map_l2.predict(X_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "e31f1c39-0286-419b-b5e8-b50e0b486bc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "map_l1=LogisticRegression(\n",
    "    penalty='l1',\n",
    "    solver='liblinear',\n",
    "    C=1.0,\n",
    "    max_iter=5000,\n",
    "    random_state=42,\n",
    ")\n",
    "map_l1.fit(X_train,Y_train)\n",
    "Y_pred_l1=map_l1.predict(X_test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "d1cf0253-035b-4100-9846-04d496190b82",
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate(model_name,Y_true,Y_pred):\n",
    "    print(\"\\n\",\"=\"*40)\n",
    "    print(model_name)\n",
    "    print(\"=\"*40)\n",
    "\n",
    "    print(\"Accuracy:\",accuracy_score(Y_true,Y_pred))\n",
    "    print(\"Precision:\",precision_score(Y_true,Y_pred))\n",
    "    print(\"Recall:\",recall_score(Y_true,Y_pred))\n",
    "    print(\"F1 Score:\",f1_score(Y_true,Y_pred))\n",
    "\n",
    "    print(\"\\nCnfusion Matrix\")\n",
    "    print(confusion_matrix(Y_true,Y_pred))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "59117822-e633-41c6-870b-a12eb672fc4c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      " ========================================\n",
      "MLE\n",
      "========================================\n",
      "Accuracy: 0.9210526315789473\n",
      "Precision: 0.9701492537313433\n",
      "Recall: 0.9027777777777778\n",
      "F1 Score: 0.935251798561151\n",
      "\n",
      "Cnfusion Matrix\n",
      "[[40  2]\n",
      " [ 7 65]]\n",
      "\n",
      " ========================================\n",
      "MAP(L2)\n",
      "========================================\n",
      "Accuracy: 0.9824561403508771\n",
      "Precision: 0.9861111111111112\n",
      "Recall: 0.9861111111111112\n",
      "F1 Score: 0.9861111111111112\n",
      "\n",
      "Cnfusion Matrix\n",
      "[[41  1]\n",
      " [ 1 71]]\n",
      "\n",
      " ========================================\n",
      "MAP(L1)\n",
      "========================================\n",
      "Accuracy: 0.9912280701754386\n",
      "Precision: 0.9863013698630136\n",
      "Recall: 1.0\n",
      "F1 Score: 0.993103448275862\n",
      "\n",
      "Cnfusion Matrix\n",
      "[[41  1]\n",
      " [ 0 72]]\n"
     ]
    }
   ],
   "source": [
    "evaluate(\"MLE\",Y_test,Y_pred_mle)\n",
    "evaluate(\"MAP(L2)\",Y_test,Y_pred_l2)\n",
    "evaluate(\"MAP(L1)\",Y_test,Y_pred_l1)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "f72f85f9-1e84-4269-b868-83cd65e65244",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of Zero Coefficients\n",
      "MLE: 0\n",
      "MAP L2: 0\n",
      "MAP L1: 14\n"
     ]
    }
   ],
   "source": [
    "print(\"Number of Zero Coefficients\")\n",
    "print(\"MLE:\",np.sum(mle_model.coef_[0]==0))\n",
    "print(\"MAP L2:\",np.sum(map_l2.coef_[0]==0))\n",
    "print(\"MAP L1:\",np.sum(map_l1.coef_[0]==0))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "23d2a2da-df06-41f0-85c8-bee78a1192db",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "    Model  Accuracy  Precision    Recall  F1 Score\n",
      "0     MLE  0.921053   0.970149  0.902778  0.935252\n",
      "1  MAP L2  0.982456   0.986111  0.986111  0.986111\n",
      "2  MAP L1  0.991228   0.986301  1.000000  0.993103\n"
     ]
    }
   ],
   "source": [
    "results=pd.DataFrame(columns=[\n",
    "    \"Model\",\n",
    "    \"Accuracy\",\n",
    "    \"Precision\",\n",
    "    \"Recall\",\n",
    "    \"F1 Score\"\n",
    "])\n",
    "models=[\n",
    "    (\"MLE\",mle_model,Y_pred_mle),\n",
    "     (\"MAP L2\",map_l2,Y_pred_l2),\n",
    "     (\"MAP L1\",map_l1,Y_pred_l1)\n",
    "]\n",
    "for name,model,pred in models:\n",
    "    results.loc[len(results)]=[\n",
    "        name,\n",
    "        accuracy_score(Y_test,pred),\n",
    "        precision_score(Y_test,pred),\n",
    "        recall_score(Y_test,pred),\n",
    "        f1_score(Y_test,pred)\n",
    "    ]\n",
    "print(results)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "51eeca78-8879-4ea1-aa6f-fe4acfb75686",
